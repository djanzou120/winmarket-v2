# WinMarket V2 API - Production Environment
# ⚠️ IMPORTANT: Update all secret values before deploying

# Application
NODE_ENV=production
PORT=4000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/winmarket_v2_prod

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=wm_prod:

# MinIO Storage
MINIO_ENDPOINT=https://minio.yourdomain.com
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_USE_SSL=true
MINIO_REGION=us-east-1
MINIO_BUCKET_PUBLIC=winmarket-public
MINIO_BUCKET_PRIVATE=winmarket-private
MINIO_BUCKET_TEMP=winmarket-temp

# Authentication
JWT_SECRET=your-very-secure-jwt-secret-minimum-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Better Auth
BETTER_AUTH_URL=https://api.yourdomain.com
BETTER_AUTH_SECRET=your-better-auth-secret-minimum-32-chars

# Social Auth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# GraphQL
GRAPHQL_INTROSPECTION=false
GRAPHQL_PLAYGROUND_ENABLED=false

# Security & CORS
CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com
TRUSTED_ORIGINS=https://yourdomain.com

# Logging
LOG_LEVEL=warn
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
SENTRY_DSN=

# Email (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100