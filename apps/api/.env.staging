# WinMarket V2 API - Staging Environment

# Application
NODE_ENV=staging
PORT=4000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/winmarket_v2_staging

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=wm_staging:

# MinIO Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET_PUBLIC=winmarket-staging-public
MINIO_BUCKET_PRIVATE=winmarket-staging-private
MINIO_BUCKET_TEMP=winmarket-staging-temp

# Authentication
JWT_SECRET=staging-jwt-secret-minimum-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Better Auth
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=staging-better-auth-secret-min-32-chars

# GraphQL
GRAPHQL_INTROSPECTION=true
GRAPHQL_PLAYGROUND_ENABLED=true

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://staging.yourdomain.com
TRUSTED_ORIGINS=http://localhost:3000,https://staging.yourdomain.com

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true

# Email (Development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@staging.yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500