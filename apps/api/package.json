{
  "name": "api",
  "version": "1.0.0",
  "description": "WinMarket V2 GraphQL API - Modular Monolith",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=node",
    "start": "bun run dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate-run": "bun src/scripts/migrate.ts",
    "db:seed": "bun src/scripts/seed.ts run",
    "db:seed:clear": "bun src/scripts/seed.ts clear",
    "db:reset": "bun src/scripts/reset-db.ts",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "@auth/core": "^0.34.3",
    "@graphql-tools/schema": "^10.0.0",
    "@paralleldrive/cuid2": "^2.2.0",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.6.14",
    "cors": "^2.8.5",
    "dataloader": "^2.2.2",
    "dotenv": "^16.3.0",
    "drizzle-orm": "^0.30.0",
    "express-rate-limit": "^8.5.2",
    "graphql": "^16.8.0",
    "graphql-scalars": "^1.22.0",
    "graphql-tag": "^2.12.6",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.0",
    "minio": "^8.0.7",
    "pg": "^8.21.0",
    "postgres": "^3.4.0",
    "winston": "^3.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/cors": "^2.8.0",
    "drizzle-kit": "^0.20.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  }
}