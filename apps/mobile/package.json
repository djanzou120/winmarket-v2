{
  "name": "@winmarket/mobile",
  "version": "1.0.0",
  "description": "WinMarket V2 Mobile Application",
  "main": "expo/index.js",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf node_modules .expo dist"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-constants": "~16.0.0",
    "expo-linking": "~6.3.0",
    "expo-router": "~3.5.0",
    "expo-splash-screen": "~0.27.0",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "@tamagui/animations-react-native": "^1.103.0",
    "@tamagui/config": "^1.103.0",
    "@tamagui/core": "^1.103.0",
    "@tamagui/font-inter": "^1.103.0",
    "@tamagui/theme-base": "^1.103.0",
    "tamagui": "^1.103.0",
    "@apollo/client": "^3.9.0",
    "graphql": "^16.8.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "react-native-get-random-values": "~1.11.0",
    "@winmarket/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "@types/react-native": "~0.73.0",
    "typescript": "~5.3.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.0.0",
    "@tamagui/babel-plugin": "^1.103.0"
  },
  "expo": {
    "install": {
      "exclude": ["react-native-safe-area-context"]
    }
  }
}